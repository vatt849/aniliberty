<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="aniliberty.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:aniliberty.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:adr="using:aniliberty.Api.Data.Releases"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Docked Progress Bar at Top -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     ShowPaused="False"
                     ShowError="False"
                     x:Name="LoaderBar" />

        <!-- Main Content Area -->
        <Frame Grid.Row="1"
               x:Name="MainContentFrame">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Панель переключения -->
                <StackPanel Orientation="Horizontal"
                            Margin="12,8"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="8"
                            Padding="4"
                            HorizontalAlignment="Right">
                    <RadioButton x:Name="ListRadioButton"
                                 IsChecked="True"
                                 Style="{StaticResource ToggleRadioButtonStyle}"
                                 Command="{x:Bind ViewModel.SwitchLayoutCommand}"
                                 CommandParameter="List"
                                 GroupName="LayoutGroup"
                                 Width="44"
                                 Height="44"
                                 Padding="0">
                        <FontIcon Glyph="&#xE8BC;"
                                  FontSize="20" />
                    </RadioButton>
                    <RadioButton x:Name="GridRadioButton"
                                 Style="{StaticResource ToggleRadioButtonStyle}"
                                 Command="{x:Bind ViewModel.SwitchLayoutCommand}"
                                 CommandParameter="Grid"
                                 GroupName="LayoutGroup"
                                 Margin="4,0,0,0"
                                 Width="44"
                                 Height="44"
                                 Padding="0">
                        <FontIcon Glyph="&#xF0E2;"
                                  FontSize="20" />
                    </RadioButton>
                </StackPanel>

                <ItemsView x:Name="CatalogItemsView"
                           Grid.Row="1"
                           ItemsSource="{x:Bind ViewModel.Items}"
                           SelectionMode="None">
                    <ItemsView.Layout>
                        <StackLayout />
                    </ItemsView.Layout>
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="adr:ReleaseCatalog">
                            <ItemContainer AutomationProperties.Name="{x:Bind ID}"
                                           Margin="8">
                                <Grid CornerRadius="8"
                                      Padding="12"
                                      Background="{ThemeResource CardBackgroundFillColorDefault}"
                                      Tapped="OnItemTapped">
                                    <!-- Обработчик в code-behind для клика по элементу -->

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Изображение с поэтапной загрузкой -->
                                    <Border CornerRadius="8">
                                        <Image Grid.Column="0"
                                               Width="150"
                                               Stretch="UniformToFill"
                                               x:Phase="2"
                                               Source="{x:Bind PosterUrl, Mode=OneWay}">
                                            <Image.Resources>
                                                <BitmapImage x:Name="Placeholder"
                                                             DecodePixelWidth="150" />
                                            </Image.Resources>
                                        </Image>
                                    </Border>

                                    <!-- Текст -->
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   x:Phase="1" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   FontSize="14"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   x:Phase="1" />
                                    </StackPanel>

                                    <!-- Кнопки действий -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Margin="8,0,0,0">
                                            <FontIcon Glyph="&#xE734;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
            </Grid>
        </Frame>
    </Grid>
</Page>
