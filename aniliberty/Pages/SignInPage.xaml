<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="aniliberty.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aniliberty.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical"
                    Margin="20">
            <TextBox x:Name="UsernameBox"
                     PlaceholderText="Имя пользователя / E-mail"
                     Margin="4"
                     Width="350"
                     FontSize="20" />
            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="0"
                         Width="350"
                         FontSize="20"
                         Margin="4"
                         PlaceholderText="Пароль" />
            <Button x:Name="SignInButton"
                    Content="Войти"
                    Background="DodgerBlue"
                    Foreground="White"
                    Width="80"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    Margin="0,20"
                    Click="SignInButton_ClickAsync" />
            <TextBlock x:Name="ErrorMessage"
                       Text=""
                       FontSize="20"
                       Margin="4"
                       Foreground="Red"
                       TextAlignment="Center" />
            <TextBlock Text="Не зарегистрированы?"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" />
            <TextBlock x:Name="RegisterButtonTextBlock"
                       Foreground="DodgerBlue"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16">
        <Hyperlink NavigateUri="https://anilibria.top/app/auth/login">Зарегистрироваться</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
