<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="aniliberty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:aniliberty"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Bind TitleText, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="TitleBar"
                  Grid.Row="0"
                  Title="{x:Bind TitleText, Mode=OneWay}"
                  IsBackButtonVisible="{x:Bind RootFrame.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="True"
                  Subtitle="{x:Bind SubtitleText, Mode=OneWay}"
                  BackRequested="TitleBar_BackRequested"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- CRITICAL: This forces the TitleBar's internal Content presenter to stretch -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogoTransparent.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="NotificationButton"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Width="Auto"
                              Height="Auto">
                            <FontIcon Glyph="&#xEDAC;"
                                      HorizontalAlignment="Center" />
                            <InfoBadge x:Name="NotificationInfoBadge"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource AttentionDotInfoBadgeStyle}">
                            </InfoBadge>
                        </Grid>
                    </Button>
                    <Button x:Name="ProfileButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="16">
                        <PersonPicture Width="30"
                                       Height="30"
                                       Initials=""
                                       Margin="0"
                                       ProfilePicture="ms-appx:///Assets/TransparentSquare.png" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
            <TitleBar.Content>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox Grid.Column="0"
                                    QueryIcon="Find"
                                    AutomationProperties.Name="Search"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="220"
                                    MaxWidth="500"
                                    PlaceholderText="Поиск по каталогу..."/>
                </Grid>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView x:Name="RootNavigationView"
                        Grid.Row="1"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        Header="Header"
                        AlwaysShowHeader="False"
                        ExpandedModeThresholdWidth="1150"
                        PaneDisplayMode="Auto"
                        SelectionFollowsFocus="Disabled"
                        IsTabStop="False"
                        ItemInvoked="RootNavigationView_ItemInvoked"
                        Loaded="RootNavigationView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Недавние релизы"
                                    Tag="aniliberty.Pages.RecentPage"
                                    x:Name="Recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Каталог"
                                    Tag="aniliberty.Pages.CatalogPage"
                                    x:Name="Catalog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Избранное"
                                    Tag="aniliberty.Pages.FavouritesPage"
                                    x:Name="Favourites"
                                    Visibility="{x:Bind FavMenuVisible, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OutlineStar" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame">
                <InfoBar x:Name="ErrorInfo"
                         IsOpen="True"
                         Severity="Error"
                         Title="Error"
                         Message="No content to display" />
            </Frame>
        </NavigationView>
    </Grid>

</Window>
